#pragma once

// DFPlayer Mini SD card layout: folders must be named "01".."99" and contain
// sequentially numbered files "001.mp3".."NNN.mp3" (DFPlayer's folder+file
// playback mode). Point each folder below at the SD card directory holding
// that effect set, and keep *_TRACK_COUNT in sync with how many files are
// actually in it so random selection stays in range.

// Played by the "default" effect: a random file from this folder.
#define SOUNDBOX_DEFAULT_FOLDER 1
#define SOUNDBOX_DEFAULT_TRACK_COUNT 1

// Played by the "alternate" effect: a random file from this folder.
#define SOUNDBOX_ALTERNATE_FOLDER 2
#define SOUNDBOX_ALTERNATE_TRACK_COUNT 1

// DFPlayer Mini's volume range is 0-30. "volume-up"/"volume-down" effects
// step by SOUNDBOX_VOLUME_STEP within that range.
#define SOUNDBOX_DEFAULT_VOLUME 20
#define SOUNDBOX_VOLUME_STEP 5

// "Track finished" detection: the DFPlayer's UART "finished" notification is
// unreliable on this hardware, so the module's BUSY pin (wired to
// DFPLAYER_BUSY_PIN, active low while playing) is the primary signal - it's
// driven directly by the chip, independent of the flaky serial link. Ignore
// it for this long after a track starts, since BUSY takes a moment to drop
// low after the play command is sent.
#define SOUNDBOX_MIN_PLAY_MS 1500UL

// Once BUSY first reads idle (HIGH), require it to keep reading idle for
// this long before trusting it - guards against a brief/glitchy HIGH read
// being mistaken for the track actually finishing.
#define SOUNDBOX_BUSY_CONFIRM_MS 1500UL
